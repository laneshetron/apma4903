# Kalshi API credentials. Generate at https://kalshi.com/account/profile (API Keys section).
# Save the downloaded private key PEM somewhere outside the repo, or in the repo root (*.pem is gitignored).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi-key.pem
# prod | demo  (overrides `env` in config.yaml when set)
KALSHI_ENV=
